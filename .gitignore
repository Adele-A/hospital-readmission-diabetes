# Data — not committed except the manifest.
# Anchored to repo root (leading slash) so it does NOT match src/data/.
# Use /data/* (contents) rather than /data/ so git can still descend to
# re-include data/raw/MANIFEST.json below.
/data/*
!/data/raw/
/data/raw/*
!/data/raw/MANIFEST.json

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Note: reports/figures/*, reports/dashboard_preview.html and dashboard/data/*.csv
# ARE committed on purpose — they are portfolio deliverables that must render on
# GitHub and feed the Power BI build without re-running the pipeline.

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
